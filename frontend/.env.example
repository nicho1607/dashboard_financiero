# ===== Configuración del Frontend =====
# Copia este archivo a .env y completa con tus valores.
# Las variables deben empezar con VITE_ para que Vite las exponga.

# URL base de la API del backend.
# En desarrollo: http://localhost:8000/api
# En producción: https://tu-backend.onrender.com/api  (o donde despliegues el backend)
VITE_API_URL=http://localhost:8000/api

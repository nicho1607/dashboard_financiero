# ===== Configuración del Backend =====
# Copia este archivo a .env y completa con tus valores reales.
# NUNCA subas el archivo .env real al repositorio.

# URL de conexión a PostgreSQL
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/finance_db

# Clave secreta para firmar los tokens JWT.
# Genera una segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=genera-una-clave-secreta-larga-y-aleatoria

# Orígenes permitidos para CORS (separados por coma).
# En producción pon la URL de tu frontend en Vercel.
# Ejemplo: https://mi-dashboard.vercel.app
CORS_ORIGINS=http://localhost:5173

# Entorno: development o production
ENVIRONMENT=development

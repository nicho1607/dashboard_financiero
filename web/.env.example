# ===== Variables de entorno =====
# Copia este archivo a .env y completa con tus valores reales.
# NUNCA subas el archivo .env real al repositorio.

# URL de conexión a PostgreSQL (Neon, Supabase, local, etc.)
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASEDATOS
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/finance_db"

# Clave secreta para firmar los tokens JWT.
# Genera una segura con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY="genera-una-clave-secreta-larga-y-aleatoria"
